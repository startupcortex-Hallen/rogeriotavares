# ============================================================
# Hostinger — public_html/.htaccess
# App Oficial Rogério Tavares 45788 (Flutter Web)
# ============================================================

# MIME e compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/wasm application/xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain application/javascript application/json image/svg+xml application/wasm application/xml
  <IfModule mod_headers.c>
    Header append Vary Accept-Encoding
  </IfModule>
</IfModule>

# Cache de arquivos estáticos (performance)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Não guardar em cache o HTML principal (Sempre atualizado)
  <FilesMatch "index\.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Arquivos com hash do Flutter: cache imutável
  <FilesMatch "flutter\.js|main\.dart\.js|flutter\.wasm|assets/.*">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Segurança básica
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
</IfModule>

# SPA — todas as rotas caem no index.html
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Não reescrever arquivos e pastas existentes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rotas limpas do Flutter Web (o /admin é SPA e é protegido por auth + RLS)
  RewriteRule ^ /index.html [L]
</IfModule>

# Bloquear listagem de diretórios
Options -Indexes